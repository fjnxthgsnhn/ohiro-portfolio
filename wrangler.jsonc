{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ohiro-portfolio",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // /api/* だけ Worker のコードを通し、それ以外は静的ファイルをそのまま返す
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ohiro-contact",
      "database_id": "b0ebe62e-9503-4709-b129-f4e7072b279d"
    }
  ]
  // Secret: DISCORD_WEBHOOK_URL（wrangler secret put で登録）
}
